# IBM Cloudant Web UI Configuration
# Provide your Cloudant instance URL and either an IBM Cloud IAM API Key or Basic Auth credentials.

# 1. Cloudant Account URL (e.g. https://xxxxxxxx-bluemix.cloudantnosqldb.appdomain.cloud or https://username.cloudant.com)
CLOUDANT_URL=

# 2. Authentication Option A (Recommended for IBM Cloud): IBM Cloud IAM API Key
CLOUDANT_APIKEY=

# 3. Authentication Option B (Legacy or CouchDB): Username & Password
CLOUDANT_USERNAME=
CLOUDANT_PASSWORD=

# Backend server port
PORT=3001
